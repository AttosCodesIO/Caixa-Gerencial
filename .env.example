# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Módulo Relatórios — conexão Oracle somente leitura (api/relatorios/*).
# Usuário de consulta do MEGA Cloud; as queries leem a base ATTOS pelo dblink @ATTOS2.
# Na Vercel, cadastrar as três variáveis abaixo em Project Settings > Environment Variables.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING="(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=dbconnect.megaerp.online)(PORT=4221))(CONNECT_DATA=(SERVER=DEDICATED)(SERVICE_NAME=xepdb1)))"
# Opcional, somente local: caminho do Oracle Instant Client para forçar o modo "Thick".
# Não definir na Vercel — lá a conexão usa o modo "Thin" (padrão do node-oracledb).
# ORACLE_CLIENT_LIB_DIR=
